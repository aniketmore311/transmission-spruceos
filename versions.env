# ---------------------------------------------------------------------------
# Pinned versions for the reproducible aarch64 (musl, fully static) build of
# transmission-daemon for the TrimUI Smart Pro (SpruceOS).
#
# Every download is verified against a SHA256. Override values via environment
# or build.sh flags. See README.md for rebuild instructions.
# ---------------------------------------------------------------------------

# Official Transmission release to build (build.sh --version overrides this).
TRANSMISSION_VERSION=4.1.3
# SHA256 of transmission-<ver>.tar.xz. Leave empty to auto-resolve from the
# GitHub release API at build time.
TRANSMISSION_SHA256=ce7d2d8b101f7eb54bc3cf0bc55f52f7ebd4a25fa48e00bdca9a7e0fc02617da

# musl.cc cross toolchain (host x86_64 -> target aarch64-linux-musl).
MUSL_TOOLCHAIN_URL=https://musl.cc/aarch64-linux-musl-cross.tgz
MUSL_TOOLCHAIN_SHA256=c909817856d6ceda86aa510894fa3527eac7989f0ef6e87b5721c58737a06c38

# External static dependencies. Everything else (libevent, libdeflate, dht,
# libutp, libb64, libpsl, libnatpmp, miniupnpc, fmt, rapidjson, ...) is bundled
# inside the Transmission source tree and built from there.
OPENSSL_VERSION=3.0.16
OPENSSL_SHA256=57e03c50feab5d31b152af2b764f10379aecd8ee92f16c985983ce4a99f7ef86
CURL_VERSION=8.12.1
CURL_SHA256=7b40ea64947e0b440716a4d7f0b7aa56230a5341c8377d7b609649d4aea8dbcf
